{
  "manifest_version": 3,
  "name": "highlander alert",
  "version": "1.1",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Highlander Alert settings"
  },
  "content_scripts": [
    {
      "matches": ["https://tf2center.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["alert.mp3"], "matches": ["https://tf2center.com/*"] }
  ]
}
